# Server-only values. Never use real credentials in a VITE_ variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME
WORKSPACE_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WORKSPACE_VAULT_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
WORKSPACE_ADMIN_USERNAME=workspace-admin
WORKSPACE_ADMIN_EMAIL=admin@example.com
WORKSPACE_ADMIN_PASSWORD=CHANGE_ME-With-A-Random-Password-2026
WORKSPACE_MAX_UPLOAD_MB=20

# Frontend application launch URLs. Rebuild after changing these values.
VITE_CG_STUDIO_URL=http://localhost:8082
VITE_FINORA_URL=http://localhost:8083
VITE_TRUHYRE_URL=
VITE_GROWTH_ENGINE_URL=
VITE_ENABLE_HERO_VIDEO=true
